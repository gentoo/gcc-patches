From 11bbc1974ae208526eeee8293ab3070a23c5fc32 Mon Sep 17 00:00:00 2001
Message-ID: <11bbc1974ae208526eeee8293ab3070a23c5fc32.1792763421.git.sam@gentoo.org>
From: Alfie Richards <alfie.richards@arm.com>
Date: Fri, 23 Oct 2026 12:34:08 +0000
Subject: [PATCH] vect: Fix final iterations counts and latch values for peeled
 early break [PR 127805]

Hi all,

Sorry for the delay on this fix, it really sent me on a whole journey,
but I learnt a lot! For instance I learnt my understanding of the
early break peeling and how it interacts with niters and final_iv was
completely off :)

I'm pretty sure this is now correct, and cleans up some of the weirdness
in the code.

Unfortunately we stil have pretty poor test coverage for early break and
especially early-break peeled.  However the gmp test suite serves as a
pretty excellent test of it in my expereince now!

Bootstrapped and regr-tested on x86_64-linux-gnu and aarch64-linux-gnu.

GMP testsuite run with a bunch of different vectorization settings
for x86_64 and aarch64.

Okay for master?
Alfie Richards
---
 .../vect/vect-early-break_147-pr128028.c      | 117 ++++++++++++++++++
 gcc/tree-vect-loop-manip.cc                   |  88 +++++--------
 gcc/tree-vect-loop.cc                         |   5 +-
 3 files changed, 151 insertions(+), 59 deletions(-)
 create mode 100644 gcc/testsuite/gcc.dg/vect/vect-early-break_147-pr128028.c

diff --git a/gcc/testsuite/gcc.dg/vect/vect-early-break_147-pr128028.c b/gcc/testsuite/gcc.dg/vect/vect-early-break_147-pr128028.c
new file mode 100644
index 000000000000..c7b1c3ad4b2b
--- /dev/null
+++ b/gcc/testsuite/gcc.dg/vect/vect-early-break_147-pr128028.c
@@ -0,0 +1,117 @@
+/* PR tree-optimization/126778 */
+/* { dg-do run } */
+/* { dg-add-options vect_early_break } */
+/* { dg-require-effective-target vect_early_break_hw } */
+/* { dg-require-effective-target vect_int } */
+
+#define N 64
+
+/* The counting exit is tested before the early exit, so the loop body runs
+   one time less than the loop header.  The vector loop must not process a
+   lane for the iteration that only tests the counter, as that lane reads the
+   element next to the arrays.  */
+
+__attribute__((optimize("no-tree-vectorize")))
+__attribute__ ((noipa)) int
+differs (const long *a, const long *b, unsigned long n)
+{
+  while (n != 0)
+    {
+      n--;
+      if (a[n] != b[n])
+       return 1;
+    }
+  return 0;
+}
+__attribute__((optimize("no-tree-vectorize")))
+__attribute__ ((noipa)) int
+differs_signed (const long *a, const long *b, long n)
+{
+  if (n < 0)
+    return 2;
+  while (--n >= 0)
+    {
+      if (a[n] != b[n])
+       return 1;
+    }
+  return 0;
+}
+
+__attribute__ ((noipa)) int
+differs_up (const long *a, const long *b, unsigned long n)
+{
+  unsigned long i = 0;
+  while (i != n)
+    {
+      unsigned long j = i;
+      i++;
+      if (a[j] != b[j])
+       return 1;
+    }
+  return 0;
+}
+
+/* The store before the early exit must not write the extra lane and must run
+   once for every element.  */
+
+__attribute__((optimize("no-tree-vectorize")))
+__attribute__ ((noipa)) int
+bump (const long *restrict a, const long *restrict b, long *restrict c,
+      unsigned long n)
+{
+  while (n != 0)
+    {
+      n--;
+      c[n] += 1;
+      if (a[n] != b[n])
+       return 1;
+    }
+  return 0;
+}
+static long abuf[N + 16] __attribute__ ((aligned (64)));
+static long bbuf[N + 16] __attribute__ ((aligned (64)));
+static long cbuf[N + 16] __attribute__ ((aligned (64)));
+
+__attribute__((optimize("no-tree-vectorize")))
+int
+main (void)
+{
+
+  for (unsigned long n = 0; n <= N; n++)
+    for (int off = 0; off < 8; off++)
+      {
+       /* Start the arrays at every alignment of a 64 byte vector and give
+          the elements around them different values.  */
+       long *a = abuf + 8 + off;
+       long *b = bbuf + 8 + off;
+       long *c = cbuf + 8 + off;
+       for (unsigned long i = 0; i < n; i++)
+         a[i] = b[i] = c[i] = i * 3 + 1;
+       a[-1] = 1;
+       b[-1] = 2;
+       c[-1] = 5;
+       a[n] = 3;
+       b[n] = 4;
+       c[n] = 6;
+
+       if (differs (a, b, n) != 0 || differs_signed (a, b, n) != 0
+           || differs_up (a, b, n) != 0)
+         __builtin_abort ();
+
+       if (bump (a, b, c, n) != 0 || c[-1] != 5 || c[n] != 6)
+         __builtin_abort ();
+       for (unsigned long i = 0; i < n; i++)
+         if (c[i] != i * 3 + 2)
+           __builtin_abort ();
+
+       if (n > 0)
+         {
+           b[n / 2]++;
+           if (differs (a, b, n) != 1 || differs_signed (a, b, n) != 1
+               || differs_up (a, b, n) != 1)
+             __builtin_abort ();
+         }
+      }
+
+  return 0;
+}
