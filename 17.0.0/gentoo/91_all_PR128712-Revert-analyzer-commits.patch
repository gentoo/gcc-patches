-concat_bit_vector::key::
-get_size (scalar_manager<concrete_bit_size> &bit_mgr) const
-{
-  const symbolic_bit_size *sum = &bit_mgr.get_concrete (0_bits);
-  for (auto iter : m_bit_vectors)
