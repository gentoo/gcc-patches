-	       bit_contents_b,
-	       conc_bit_overlay_a,
-	       nullptr,
-	       type,
-	       merger);
-	}
-    }
-  else
-    {
-      if (conc_bit_overlay_b)
-	{
-	  if (&conc_bit_overlay_b->get_baseline () == &bit_contents_a)
-	    return concrete_bit_overlay::can_merge_p
-	      (bit_contents_a,
-	       bit_contents_b,
-	       bit_contents_a,
-	       nullptr,
-	       conc_bit_overlay_b,
-	       type,
-	       merger);
