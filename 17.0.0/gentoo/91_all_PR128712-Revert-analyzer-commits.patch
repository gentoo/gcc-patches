-    ASSERT_SAME_SYMBOLIC_NODE
-      (x_times_5.get_cropped_bytes (concrete_byte_range (3_bytes, 2_bytes)),
-       bv_mgr.get_concat_bits
-       ({&x.get_suffix (1_byte),
-	 &x.get_prefix (1_byte)}));
-
-    /* Bytes [3,19):
