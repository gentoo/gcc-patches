-      (sizeof_buffer,
-       ("bits_from_bytes_scalar\n"
-	"`- product<bytes>\n"
-	"   +- concrete_scalar<bytes>: 24\n"
-	"   `- named_test_scalar<integer>: 'n'\n"));
-
-    ASSERT_SCALAR_DUMP_INLINE_EQ
-      (sizeof_buffer,
-       units::role::size,
-       "bits_from_bytes_scalar(24 bytes * n)");
