-  auto &mgr = node_mgr.get_bit_vector_manager ();
-
-  auto &abc0 = mgr.get_bits_for_constant (string_cst_ptr);
-
-  for (concrete_byte_offset i = 0_bytes; i < 4_bytes; ++i)
