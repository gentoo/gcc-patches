-  auto &bit_mgr = m_node_mgr.get_scalars ().get_bits ();
-  auto &bv = bv_mgr.get_bits_for_constant (tree_cst);
-
-  return (get_uninitialized ()
-	  .set_bits (symbolic_bit_range (bit_mgr.get_concrete (0_bits),
-					 bv.get_size ()),
-		     bv,
-		     nullptr));
