-class cropped_bit_vector : public bit_vector
-{
-public:
-  struct key
-  {
-    key (const bit_vector *uncropped_bv,
-	 symbolic_bit_range bits_to_use)
-    : m_uncropped_bv (uncropped_bv),
-      m_bits_to_use (bits_to_use)
-    {
-    }
-
