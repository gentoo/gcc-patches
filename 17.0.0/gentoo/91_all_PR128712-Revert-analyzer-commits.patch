-bool
-untracked_bit_contents::track_value_liveness_p (const symbolic::value_node &val)
-{
-  if (auto *sval = val.dyn_cast_svalue ())
-    return track_svalue_liveness_p (*sval);
-  else if (auto *bv = val.dyn_cast_bit_vector ())
