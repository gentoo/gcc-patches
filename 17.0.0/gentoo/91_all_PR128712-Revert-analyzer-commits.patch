-  if (auto repeated_bv = inner_bv.dyn_cast_repeated_bit_vector ())
-    return &get_repeated_bits (repeated_bv->get_inner_bit_vector (),
-			       (repeated_bv->get_repeat_count ()
-				* repeat_count));
