-    const symbolic_bit_size &
-    get_size (scalar_manager<concrete_bit_size> &bit_mgr) const;
-
-    std::vector<const bit_vector *> m_bit_vectors;
-  };
-
-  enum kind get_kind () const final override
-  {
-    return kind::concat;
-  }
